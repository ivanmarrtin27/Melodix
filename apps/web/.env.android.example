# Build Android / Capacitor — copiar a .env.production.local o exportar al build
# La app nativa NO usa el proxy Vite: la API debe ser HTTPS público (o IP LAN en debug).

# Producción (obligatorio para Play / dispositivo real fuera de Wi‑Fi del PC):
VITE_API_URL=https://TU-API.onrender.com

# Debug en el mismo Wi‑Fi que el PC (API en :8000, host LAN):
# VITE_API_URL=http://192.168.1.XX:8000

# Last.fm (opcional)
# VITE_LASTFM_KEY=
