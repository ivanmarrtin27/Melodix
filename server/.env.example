# Entorno: development | production
MELODIX_ENV=development

# Host y puerto (Render/Railway/Fly inyectan PORT automáticamente)
HOST=0.0.0.0
PORT=8000

# Orígenes CORS permitidos (separados por coma).
# En producción pon la URL de tu PWA, ej: https://melodix.vercel.app
MELODIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost

# Workers uvicorn (1 recomendado: yt-dlp usa pool de hilos interno)
UVICORN_WORKERS=1
LOG_LEVEL=info

# Opcional — Top 50 España oficial de Spotify (Client Credentials)
# https://developer.spotify.com/dashboard → Create app → Client ID + Secret
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
