# API FastAPI
# Déjalo VACÍO en local/móvil Wi‑Fi → la PWA usa /api (proxy Vite).
# NO pongas http://127.0.0.1:8000 si pruebas en el teléfono: el móvil no llega a “localhost” del PC.
# Solo pon URL absoluta en producción, ej: https://melodix-api.onrender.com
VITE_API_URL=

# Last.fm — recomendaciones (gratis: https://www.last.fm/api/account/create)
VITE_LASTFM_KEY=

# Opcional — Top 50 España de Spotify (Client Credentials en server/.env)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# ── Backend (server/.env o variables del hosting) ───────────────────
# MELODIX_ENV=production
# MELODIX_CORS_ORIGINS=https://tu-pwa.vercel.app,capacitor://localhost,https://localhost
# PORT=8000

# Android / Capacitor: ver apps/web/.env.android.example y docs/PLAY.md
